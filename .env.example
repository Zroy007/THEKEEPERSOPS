# ==============================================================================
# WORKFLOW OPERATIONS PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT: Never commit actual credentials or secrets to version control.
# All sensitive variables are consumed strictly on the server-side.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Port the server listens on (Cloud Run defaults to 8080 or 3000)
PORT=3000

# Node execution environment: 'production' or 'development'
NODE_ENV=production

# Set to 'false' to enable live API integrations with external services.
# When 'true', all external APIs (GoLogin, Telegram, Outlook, Sheets) run safe mocks.
MOCK_MODE=true

# High-entropy secret key used for signing internal operator JWT tokens
JWT_SECRET=replace-with-a-secure-random-string-at-least-32-chars

# Base URL where the platform is publicly hosted (for webhook callbacks and links)
APP_URL=https://my-workflow-app-182611251697.run.app

# Bootstrap Super Admin Credentials (Provisioned on first deployment)
# User is forced to change the temporary bootstrap password immediately upon first login
SUPERADMIN_EMAIL=zakwanrhmn@gmail.com
SUPERADMIN_INITIAL_PASSWORD=InitialBootstrapPassword123!

# ------------------------------------------------------------------------------
# 2. FIREBASE / FIRESTORE & PERSISTENCE CONFIGURATION
# ------------------------------------------------------------------------------
# Persistence datastore mode:
# - 'firestore'           : Canonical production Cloud Firestore (MANDATORY in production)
# - 'firestore-emulator'  : Local Firebase Firestore Emulator (requires FIRESTORE_EMULATOR_HOST)
# - 'in-memory'           : Isolated in-memory datastore (DEVELOPMENT/TEST ONLY - rejected in production)
PERSISTENCE_MODE=firestore

# Optional: Host address for Firestore Emulator (e.g. localhost:8080 or firestore:8080)
FIRESTORE_EMULATOR_HOST=

# Google Cloud / Firebase Project ID
FIREBASE_PROJECT_ID=my-gcp-project-id

# Service account client email with 'Cloud Datastore User' role
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@my-gcp-project-id.iam.gserviceaccount.com

# Service account private key (enclose in quotes, preserve \n formatting)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firestore database ID ('(default)' unless using a named database)
FIRESTORE_DATABASE_ID=(default)

# ------------------------------------------------------------------------------
# 3. GOLOGIN CLOUD BROWSER API
# ------------------------------------------------------------------------------
# GoLogin API authentication token (from GoLogin Settings -> API)
GOLOGIN_API_TOKEN=your_gologin_api_token_here

# GoLogin REST API endpoint
GOLOGIN_API_URL=https://api.gologin.com

# GoLogin Cloud Browser service endpoint
GOLOGIN_CLOUD_URL=https://cloudbrowser.gologin.com

# ------------------------------------------------------------------------------
# 4. TELEGRAM BOT NOTIFICATIONS
# ------------------------------------------------------------------------------
# Telegram Bot API token obtained from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Default Telegram group or channel chat ID for incident & human checkpoint broadcasts
TELEGRAM_DEFAULT_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# 5. MICROSOFT GRAPH (OUTLOOK) INTEGRATION
# ------------------------------------------------------------------------------
# Azure Active Directory Tenant ID (Directory ID)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Azure AD Application (client) ID with Mail.Read permissions
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Azure AD Client Secret value
AZURE_CLIENT_SECRET=your_azure_client_secret_value

# The dedicated business mailbox monitored for review outcomes and verification notices
AUTHORIZED_OUTLOOK_MAILBOX=operations-bot@yourdomain.com

# ------------------------------------------------------------------------------
# 6. GOOGLE SHEETS SYNCHRONIZATION
# ------------------------------------------------------------------------------
# Google Spreadsheet ID (from docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=1A2B3C4D5E6F7G8H9I0JkLmNoPqRsTuVwXyZ

# Google Service Account email with Editor permission on the spreadsheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-sync-sa@my-gcp-project-id.iam.gserviceaccount.com

# Google Service Account private key
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 7. OPTIONAL: GOOGLE GEMINI AI (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# If enabling automated parsing of unstructured application feedback
GEMINI_API_KEY=
